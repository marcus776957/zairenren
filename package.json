{
  "name": "zairenren",
  "version": "1.0.0",
  "description": "再忍忍 - 实时计算你的打工收入",
  "scripts": {
    "dev": "uni",
    "build": "uni build",
    "lint": "eslint src --ext .js,.vue",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
